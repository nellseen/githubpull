# GitHub Personal Access Tokens (comma-separated for multi-account support)
# Generate from https://github.com/settings/tokens with 'repo' and 'user:email' scopes
GH_TOKENS=

# Vercel API Tokens (comma-separated for multi-token/multi-account support)
# Generate from https://vercel.com/account/tokens
VERCEL_TOKENS=

# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=

# Server Port
PORT=3000

# Base directory for local workspace deployments (defaults to ./deployments)
BASE_DIR=